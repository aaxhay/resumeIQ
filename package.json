{
  "name": "resumeiq",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ai:live": "node --env-file=.env.local --conditions=react-server scripts/verify-gemini.ts",
    "test:e2e": "playwright test",
    "test:e2e:dev": "playwright test --config=playwright.dev.config.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@google/genai": "3.0.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "fast-xml-parser": "5.12.0",
    "htmlparser2": "12.0.0",
    "lucide-react": "1.70.0",
    "mammoth": "1.13.0",
    "next": "16.4.5",
    "pdf-parse": "2.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tw-animate-css": "1.4.0",
    "yauzl": "3.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/yauzl": "3.4.0",
    "docx": "9.15.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "pdf-lib": "1.17.1",
    "postcss": "8.5.32",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
