# The foundation runs without secrets. Copy to .env.local when integrating Gemini.
# Server-only: never prefix either variable with NEXT_PUBLIC_.
GEMINI_API_KEY=
# Set an explicitly chosen, available stable text model before enabling analysis.
# No model is silently selected, and no provider requests exist in this milestone.
GEMINI_MODEL=

# Supabase is intentionally deferred. No account, storage, or database is required.
# Add its environment contract only when a persistence feature is approved.
