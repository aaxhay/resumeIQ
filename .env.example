# Server only. Copy this template to ignored .env.local; never commit credentials.
# No NEXT_PUBLIC_ prefix. Extraction and deterministic checks need no key.
GEMINI_API_KEY=
# Stable model verified with live synthetic requests on 2026-11-06.
# Recheck model availability/access before changing it; no silent fallback.
GEMINI_MODEL=gemini-3.5-flash-lite

# Defaults to synthetic examples only. Set paid-reviewed ONLY after the operator
# verifies paid-service billing, applicable Google terms, supported regions,
# adult-only access, privacy disclosures, and deployment safeguards.
# This is an operator attestation, not automatic verification of billing.
GEMINI_DATA_POLICY=synthetic-only

# Supabase is deferred. No account, storage, or database is required.
