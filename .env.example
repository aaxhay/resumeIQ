# Copy to ignored .env.local without overwriting existing settings; never commit secrets.
# Gemini credentials are server-only, with no NEXT_PUBLIC_ prefix.
# Extraction and deterministic checks need no key.
GEMINI_API_KEY=
# Stable model verified with live synthetic requests on 2026-11-06.
# Recheck model availability/access before changing it; no silent fallback.
GEMINI_MODEL=gemini-3.5-flash-lite

# Defaults to synthetic examples only. Set paid-reviewed ONLY after the operator
# verifies paid-service billing, applicable Google terms, supported regions,
# adult-only access, privacy disclosures, and deployment safeguards.
# This is an operator attestation, not automatic verification of billing.
GEMINI_DATA_POLICY=synthetic-only

# Optional Supabase. Anonymous review/edit/export never requires an account/database.
# Only the publishable key is public by design. NEVER use secret/service-role keys here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Enable only AFTER applying the migration and verifying scheduled deletion; see docs/supabase.md.
SUPABASE_HISTORY_ENABLED=false
